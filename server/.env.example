PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/calflow?retryWrites=true&w=majority
JWT_SECRET=your_development_jwt_secret_min_32_characters_long
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# External Reminder Scheduler Authentication
# Required in production for authenticating external cron trigger requests:
# POST /api/reminders/process with Header: Authorization: Bearer <secret>
REMINDER_SCHEDULER_SECRET=your_random_secure_scheduler_secret_token_here

# In-Process Reminder Scheduler (Optional)
# In development, the in-process 60s interval scheduler runs automatically.
# Set to 'false' to disable in development, or 'true' to force-enable in production.
# Default in production is 'false' (relying on external trigger POST /api/reminders/process).
ENABLE_IN_PROCESS_SCHEDULER=false

